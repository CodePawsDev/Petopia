generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique @db.VarChar(254)
  passwordHash            String                   @map("password_hash")
  displayName             String                   @map("display_name") @db.VarChar(100)
  active                  Boolean                  @default(true)
  authVersion             Int                      @default(1) @map("auth_version")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  staffAssignments        StaffAssignment[]
  permissionGrants        PermissionGrant[]
  pets                    Pet[]
  groomerWorkingIntervals GroomerWorkingInterval[]
  groomerTimeOffs         GroomerTimeOff[]
  groomerServiceSkills    GroomerServiceSkill[]

  @@map("users")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model BusinessUnit {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches Branch[]
  services GroomingService[]

  @@map("business_units")
}

model Branch {
  id                      String                   @id @default(uuid()) @db.Uuid
  businessUnitId          String                   @map("business_unit_id") @db.Uuid
  code                    String                   @unique @db.VarChar(50)
  name                    String                   @db.VarChar(100)
  timezone                String                   @default("Asia/Bangkok") @db.VarChar(100)
  active                  Boolean                  @default(true)
  scheduleVersion         Int                      @default(1) @map("schedule_version")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  staffAssignments        StaffAssignment[]
  permissionGrants        PermissionGrant[]
  groomerWorkingIntervals GroomerWorkingInterval[]
  closures                BranchClosure[]

  businessUnit    BusinessUnit     @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  groomerTimeOffs GroomerTimeOff[]

  @@index([businessUnitId])
  @@map("branches")
}

enum StaffRole {
  GROOMER
  BRANCH_MANAGER
}

enum StaffPermission {
  RECEIVE_PAYMENT
}

model StaffAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  branchId  String    @map("branch_id") @db.Uuid
  role      StaffRole
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([userId, branchId, role])
  @@index([branchId, role, active])
  @@map("staff_assignments")
}

model PermissionGrant {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  branchId   String          @map("branch_id") @db.Uuid
  permission StaffPermission
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([userId, branchId, permission])
  @@index([branchId, permission, active])
  @@map("permission_grants")
}

enum PetSpecies {
  DOG
  CAT
  RABBIT
}

model Pet {
  id         String     @id @default(uuid()) @db.Uuid
  ownerId    String     @map("owner_id") @db.Uuid
  name       String     @db.VarChar(100)
  species    PetSpecies
  breed      String?    @db.VarChar(100)
  birthDate  DateTime?  @map("birth_date") @db.Date
  weightKg   Decimal?   @map("weight_kg") @db.Decimal(6, 3)
  careNotes  String?    @map("care_notes") @db.VarChar(2000)
  archivedAt DateTime?  @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, archivedAt])
  @@map("pets")
}

enum GroomingServiceKind {
  BATH
  BATH_WITH_HAIRCUT
  COAT_SPA
  EAR_CLEANING
  NAIL_TRIMMING
  TOOTH_BRUSHING
}

model GroomingService {
  id             String              @id @default(uuid()) @db.Uuid
  businessUnitId String              @map("business_unit_id") @db.Uuid
  code           String              @db.VarChar(50)
  name           String              @db.VarChar(100)
  description    String?             @db.VarChar(1000)
  kind           GroomingServiceKind
  active         Boolean             @default(true)
  sortOrder      Int                 @default(0) @map("sort_order")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  businessUnit  BusinessUnit          @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  rates         GroomingServiceRate[]
  groomerSkills GroomerServiceSkill[]

  @@unique([businessUnitId, code])
  @@unique([businessUnitId, kind])
  @@index([businessUnitId, active, sortOrder])
  @@map("grooming_services")
}

model GroomingServiceRate {
  id                 String     @id @default(uuid()) @db.Uuid
  serviceId          String     @map("service_id") @db.Uuid
  species            PetSpecies
  minWeightKg        Decimal    @map("min_weight_kg") @db.Decimal(6, 3)
  maxWeightKg        Decimal    @map("max_weight_kg") @db.Decimal(6, 3)
  priceSatang        Int        @map("price_satang")
  durationMinutes    Int        @map("duration_minutes")
  requiresAssessment Boolean    @default(false) @map("requires_assessment")
  active             Boolean    @default(true)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  service GroomingService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([serviceId, species, minWeightKg, maxWeightKg])
  @@index([serviceId, species, active])
  @@map("grooming_service_rates")
}

model GroomerWorkingInterval {
  id          String   @id @default(uuid()) @db.Uuid
  groomerId   String   @map("groomer_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  weekday     Int
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  groomer User   @relation(fields: [groomerId], references: [id], onDelete: Restrict)
  branch  Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId, groomerId, weekday])
  @@index([groomerId, weekday])
  @@map("groomer_working_intervals")
}

model GroomerTimeOff {
  id        String   @id @default(uuid()) @db.Uuid
  groomerId String   @map("groomer_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  reason    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  groomer User   @relation(fields: [groomerId], references: [id], onDelete: Restrict)
  branch  Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId, groomerId, startsAt])
  @@index([groomerId, startsAt, endsAt])
  @@map("groomer_time_offs")
}

model GroomerServiceSkill {
  id        String     @id @default(uuid()) @db.Uuid
  groomerId String     @map("groomer_id") @db.Uuid
  serviceId String     @map("service_id") @db.Uuid
  species   PetSpecies
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  groomer User            @relation(fields: [groomerId], references: [id], onDelete: Restrict)
  service GroomingService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([groomerId, serviceId, species])
  @@index([serviceId, species, active])
  @@map("groomer_service_skills")
}

model BranchClosure {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  reason    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId, startsAt, endsAt])
  @@map("branch_closures")
}
