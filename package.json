{
  "name": "petopia",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run start:dev --workspace apps/api",
    "lint": "npm run lint --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace apps/api -- --runInBand",
    "test:e2e": "npm run test:e2e --workspace apps/api -- --runInBand"
  }
}